# Copy to .env and adjust. .env is git-ignored.

DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-long-random-value-for-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Django's debug page normally replaces the site's own 404/403/400 pages while
# DEBUG is on. Leave this at True to see the real branded pages in development.
# Set it to False when you need Django's "Using the URLconf defined in..."
# listing to debug a routing problem.
# DJANGO_BRANDED_ERROR_PAGES=True

# Database. Local development uses SQLite by default.
# Set DATABASE_URL here when you want the backend to use PostgreSQL.
# This same variable can also be set in Vercel's dashboard for production.
# Example:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
#
# On Vercel, the host must be reachable from the deployment environment.
# IPv6-only hosts may fail with "Cannot assign requested address".
# To override SQLite locally and use PostgreSQL for a migration or data check,
# also set:
# USE_POSTGRES=True

# Media (food images uploaded through the admin). Leave unset to keep uploads on
# disk under MEDIA_ROOT, which is fine locally. Set it on Vercel: that filesystem
# is read-only apart from /tmp and resets every deploy, so an uploaded image is
# written where no later request can read it and comes back as a broken link.
#
# One string carries all three credentials, no quotes and no spaces:
#   CLOUDINARY_URL=cloudinary://<api key>:<api secret>@<cloud name>
# Take the key and secret from Cloudinary's dashboard under Settings > API Keys.
# The cloud name is the product environment name, NOT the key name beside it.
# Paste only the assembled URL — the dashboard's labelled table (Key Name, Date
# Created, Status) is not KEY=value, so django-environ skips those lines with
# "Invalid line: ..." on startup and the variable ends up unset.
# CLOUDINARY_URL=cloudinary://123456789012345:abcdefghijklmnopqrstuvwxyz@my-cloud

# Payments — unused today, read by orders/payments.py when Paystack is enabled.
# PAYSTACK_PUBLIC_KEY=pk_test_xxx
# PAYSTACK_SECRET_KEY=sk_test_xxx

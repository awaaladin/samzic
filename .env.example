# Copy to .env and adjust. .env is git-ignored.

DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-long-random-value-for-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Django's debug page normally replaces the site's own 404/403/400 pages while
# DEBUG is on. Leave this at True to see the real branded pages in development.
# Set it to False when you need Django's "Using the URLconf defined in..."
# listing to debug a routing problem.
# DJANGO_BRANDED_ERROR_PAGES=True

# Database. Local development uses SQLite by default.
# Set DATABASE_URL here when you want the backend to use PostgreSQL.
# This same variable can also be set in Vercel's dashboard for production.
# Example:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
#
# On Vercel, the host must be reachable from the deployment environment.
# IPv6-only hosts may fail with "Cannot assign requested address".
# To override SQLite locally and use PostgreSQL for a migration or data check,
# also set:
# USE_POSTGRES=True

# Payments — unused today, read by orders/payments.py when Paystack is enabled.
# PAYSTACK_PUBLIC_KEY=pk_test_xxx
# PAYSTACK_SECRET_KEY=sk_test_xxx

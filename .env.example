# Copy to .env and adjust. .env is git-ignored.

DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-long-random-value-for-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Database. Local development always uses SQLite (db.sqlite3) regardless of
# what DATABASE_URL says — the switch to PostgreSQL is Vercel's own VERCEL env
# var, which the platform sets for you. So this same value is safe to keep here
# and to set in the Vercel dashboard.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
#
# To point local development at PostgreSQL for a migration or a data check,
# set this for the duration of that task:
# USE_POSTGRES=True

# Payments — unused today, read by orders/payments.py when Paystack is enabled.
# PAYSTACK_PUBLIC_KEY=pk_test_xxx
# PAYSTACK_SECRET_KEY=sk_test_xxx
